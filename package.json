{
  "name": "mcsprite-manager",
  "version": "0.2.5",
  "description": "MCsprite Manager — Minecraft texture & sprite editor with community catalogue, version switcher, and animation tools",
  "main": "out/main/index.js",
  "author": "You",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "package": "npm run icon && electron-vite build && electron-builder --win --x64",
    "package:portable": "npm run icon && electron-vite build && electron-builder --win portable --x64",
    "icon": "tsx scripts/generate-icon.ts",
    "sync:vanilla": "tsx scripts/sync-vanilla.ts",
    "relay": "node relay-server.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "colord": "^2.9.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "idb-keyval": "^6.2.1",
    "immer": "^10.1.1",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "ws": "^8.21.3",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.20",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.16.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "adm-zip": "^0.6.0",
    "electron": "^32.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
